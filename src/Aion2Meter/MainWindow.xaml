<Window x:Class="Aion2Meter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Aion2Meter.Controls"
        xmlns:services="clr-namespace:Aion2Meter.Services"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Aion 2 DPS"
        Icon="/Aion2Meter;component/Assets/Brand/Aion2Meter.ico"
        Width="560"
        Height="510"
        MinWidth="520"
        MinHeight="430"
        MaxHeight="920"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        IsVisibleChanged="Window_IsVisibleChanged"
        Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF20262B" />
        <SolidColorBrush x:Key="PanelHeader" Color="#FF23292D" />
        <SolidColorBrush x:Key="PartyPanelBackground" Color="#A0192228" />
        <SolidColorBrush x:Key="PartyPanelHeader" Color="#B51B2429" />
        <SolidColorBrush x:Key="DarkStrip" Color="#66000000" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FF646A6D" />
        <SolidColorBrush x:Key="SoftLine" Color="#19FFFFFF" />
        <Style x:Key="AdaptivePanelHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelHeader}" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsePartyRowStyle}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PartyPanelHeader}" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <SolidColorBrush x:Key="MeterFill" Color="#FF27797C" />
        <!-- Exact monster target HP tint from HUD_TargetInfo.P_Prg_HpBar. -->
        <SolidColorBrush x:Key="TargetHpFill" Color="#FFF0314C" />
        <ImageBrush x:Key="DmBossAuto" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="106,118,50,50" Stretch="Uniform" />
        <ImageBrush x:Key="DmTarget" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="67,110,27,32" Stretch="Uniform" />
        <ImageBrush x:Key="DmAll" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="163,120,34,34" Stretch="Uniform" />
        <ImageBrush x:Key="DmOpacity1" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="106,60,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmOpacity2" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="164,2,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmOpacity3" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="106,2,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmHistory" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="164,60,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmViewMax" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="2,164,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmViewMin" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="2,106,54,54" Stretch="Uniform" />
        <ImageBrush x:Key="DmPlay" ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png" ViewboxUnits="Absolute" Viewbox="60,208,40,40" Stretch="Uniform" />
        <ImageBrush x:Key="AppEmblem" ImageSource="/Aion2Meter;component/Assets/Brand/Aion2MeterEmblem.png" Stretch="Uniform" />
        <!-- Native AION 2 common-window icons. -->
        <!-- Common refresh: the original double-arrow reset icon. -->
        <ImageBrush x:Key="AionRefresh" ImageSource="/Aion2Meter;component/Assets/Textures/CommonAtlas.png" ViewboxUnits="Absolute" Viewbox="540,194,50,50" Stretch="Uniform" />
        <ImageBrush x:Key="AionSettings" ImageSource="/Aion2Meter;component/Assets/Textures/CommonAtlas.png" ViewboxUnits="Absolute" Viewbox="486,194,50,50" Stretch="Uniform" />
        <ImageBrush x:Key="AionClose" ImageSource="/Aion2Meter;component/Assets/Textures/CommonAtlas.png" ViewboxUnits="Absolute" Viewbox="372,194,54,54" Stretch="Uniform" />
        <!-- Status-effect toggle drawn in the same pale, line-art language as the native HUD controls. -->
        <DrawingBrush x:Key="AionDebuffToggle" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 4,9 L 16,3 28,9 26,21 16,29 6,21 Z">
                        <GeometryDrawing.Pen><Pen Brush="#FFE8E3D6" Thickness="1.6" LineJoin="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 8,14 C 11,10 21,10 24,14 C 21,18 11,18 8,14 Z">
                        <GeometryDrawing.Pen><Pen Brush="#FFE8E3D6" Thickness="1.5" LineJoin="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFE8E3D6" Geometry="M 13.5,14 A 2.5,2.5 0 1 0 18.5,14 A 2.5,2.5 0 1 0 13.5,14" />
                    <GeometryDrawing Geometry="M 16,18 L 16,25 M 12.5,22 16,25 19.5,22">
                        <GeometryDrawing.Pen><Pen Brush="#FFD8AD68" Thickness="1.7" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Native crossed swords from the game HUD; the small badge reflects the active mode. -->
        <ImageBrush x:Key="AionCombatSwords" ImageSource="/Aion2Meter;component/Assets/Textures/HudAtlas.png"
                    ViewboxUnits="Absolute" Viewbox="916,149,40,40" Stretch="Uniform" />
        <ControlTemplate x:Key="CombatModeIconTemplate" TargetType="Control">
            <Grid Width="30" Height="32">
                <Border Width="25" Height="25" VerticalAlignment="Top" Background="{StaticResource AionCombatSwords}" />
                <Border Width="27" Height="10" VerticalAlignment="Bottom" CornerRadius="2" Background="#D912171B">
                    <TextBlock Text="{Binding CombatModeBadge}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource AionFont}" FontSize="8" FontWeight="Bold" Foreground="#FFF7F3E8" />
                </Border>
            </Grid>
        </ControlTemplate>
        <DrawingBrush x:Key="AionPartyCheck" Stretch="Uniform">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE8E3D6" Geometry="M 13,7 A 3,3 0 1 0 19,7 A 3,3 0 1 0 13,7 M 4,11 A 2,2 0 1 0 8,11 A 2,2 0 1 0 4,11 M 24,11 A 2,2 0 1 0 28,11 A 2,2 0 1 0 24,11" />
                    <GeometryDrawing Geometry="M 10,23 C 10,17 12,14 16,14 C 20,14 22,17 22,23 M 2,20 C 2,17 3,15 7,15 M 30,20 C 30,17 29,15 25,15">
                        <GeometryDrawing.Pen><Pen Brush="#FFE8E3D6" Thickness="1.8" StartLineCap="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 20,25 L 23,28 29,21">
                        <GeometryDrawing.Pen><Pen Brush="#FFD8AD68" Thickness="2.2" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PartyClassIconStyle" TargetType="Image">
            <Setter Property="Visibility" Value="{Binding HasClassIcon, Converter={StaticResource BoolToVisibility}}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#FF05090D" BlurRadius="3" ShadowDepth="0" Opacity="0.95" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFF7ECCC" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <RadialGradientBrush x:Key="ClassIconBackdrop" GradientOrigin="0.5,0.5">
            <GradientStop Color="#DD101820" Offset="0" />
            <GradientStop Color="#B3101820" Offset="0.62" />
            <GradientStop Color="#00101820" Offset="1" />
        </RadialGradientBrush>
        <!-- Native AION 2 HUD defence shield. -->
        <ImageBrush x:Key="AionMitigationShield" ImageSource="/Aion2Meter;component/Assets/Textures/HudAtlas.png" ViewboxUnits="Absolute" Viewbox="248,295,40,40" Stretch="Uniform" />
        <BitmapImage x:Key="TargetHpFrameBitmap" UriSource="/Aion2Meter;component/Assets/Textures/TargetHpFrame.png" />
        <BitmapImage x:Key="EliteHpFrameBitmap" UriSource="/Aion2Meter;component/Assets/Textures/EliteHpFrame.png" />
        <BitmapImage x:Key="HeroHpFrameBitmap" UriSource="/Aion2Meter;component/Assets/Textures/HeroHpFrame.png" />
        <BitmapImage x:Key="BossHpFrameBitmap" UriSource="/Aion2Meter;component/Assets/Textures/BossHpFrame.png" />
        <BitmapImage x:Key="DebuffIconBitmap" UriSource="/Aion2Meter;component/Assets/Textures/DebuffDefenseDown.png" />

        <LinearGradientBrush x:Key="DebuffProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFE3C58A" Offset="0" />
            <GradientStop Color="#FFB98D51" Offset="1" />
        </LinearGradientBrush>

        <DataTemplate x:Key="DebuffIconTemplate">
            <Border Width="36"
                    Height="36"
                    Margin="2"
                    Background="#CF1B2227"
                    ToolTip="{Binding Name}">
                <Grid ClipToBounds="True">
                    <Image Source="{Binding IconPath}" Margin="1" Stretch="UniformToFill" />
                    <Ellipse Width="5" Height="5" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="#FF83DAE8" Visibility="{Binding IsOtherPlayer, Converter={StaticResource BoolToVisibility}}" />
                    <Border VerticalAlignment="Bottom" Background="#DC171D22" Height="12">
                        <TextBlock Text="{Binding RemainingText}" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource AionFont}" FontSize="9" FontWeight="Bold" Foreground="#FFF4E8D1" />
                    </Border>
                    <TextBlock Text="{Binding StacksText}" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,0,2,0" FontSize="9" FontWeight="Bold" Foreground="#FFF4E8D1" />
                    <controls:SmoothProgressBar Minimum="0"
                                                Maximum="100"
                                                AnimatedValue="{Binding RemainingPercent}"
                                                Height="2"
                                                VerticalAlignment="Bottom"
                                                Foreground="{StaticResource DebuffProgressBrush}"
                                                Style="{DynamicResource RowProgressStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="{x:Type controls:MarqueeTextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource AionBodyFont}" />
            <Setter Property="Foreground" Value="#FFF3F1EA" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MarqueeTextBlock}">
                        <Border ClipToBounds="True">
                            <TextBlock x:Name="PART_Text"
                                       Text="{TemplateBinding Text}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       TextAlignment="Left"
                                       TextWrapping="NoWrap">
                                <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="LocalPlayerSparklesTemplate" TargetType="Control">
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <Border x:Name="LocalNameGlow" Opacity="0.72">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#806A6688" Offset="0" />
                            <GradientStop Color="#906F6A94" Offset="0.2" />
                            <GradientStop Color="#765B5878" Offset="0.55" />
                            <GradientStop Color="#1A4D4A61" Offset="0.82" />
                            <GradientStop Color="#004D4A61" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas Height="12" VerticalAlignment="Bottom" ClipToBounds="True">
                    <TextBlock x:Name="SparkA" Canvas.Left="0" Canvas.Top="1" Text="✦" FontFamily="Segoe UI Symbol" FontSize="6" Foreground="#FFF7F4FF">
                        <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SparkB" Canvas.Left="0" Canvas.Top="-3" Text="·" FontSize="13" FontWeight="Bold" Foreground="#FFE4DDFF">
                        <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SparkC" Canvas.Left="0" Canvas.Top="3" Text="✧" FontFamily="Segoe UI Symbol" FontSize="7" Foreground="#FFF0ECFF">
                        <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SparkD" Canvas.Left="0" Canvas.Top="-2" Text="·" FontSize="12" FontWeight="Bold" Foreground="#FFFFE8BB">
                        <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="SparkE" Canvas.Left="0" Canvas.Top="2" Text="✦" FontFamily="Segoe UI Symbol" FontSize="5" Foreground="#FFF5F2FF">
                        <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SparklesStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LocalNameGlow" Storyboard.TargetProperty="Opacity" From="0.56" To="0.82" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkA" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="150" To="-18" Duration="0:0:3.1" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkB" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" BeginTime="0:0:0.45" From="125" To="-34" Duration="0:0:2.7" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkC" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" BeginTime="0:0:1.1" From="165" To="-24" Duration="0:0:3.7" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkD" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" BeginTime="0:0:1.55" From="105" To="-42" Duration="0:0:2.4" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkE" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" BeginTime="0:0:2.05" From="142" To="-20" Duration="0:0:3.3" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkA" Storyboard.TargetProperty="Opacity" From="0.18" To="0.95" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkB" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.3" From="0.12" To="0.82" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkC" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.7" From="0.12" To="0.88" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkD" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.0" From="0.1" To="0.78" Duration="0:0:0.65" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="SparkE" Storyboard.TargetProperty="Opacity" BeginTime="0:0:1.35" From="0.1" To="0.9" Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SparklesStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="MeterLogoTemplate" TargetType="Control">
            <Border Background="{StaticResource AppEmblem}" />
        </ControlTemplate>

        <Style x:Key="RowProgressStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactTargetFillStyle" TargetType="ProgressBar" BasedOn="{StaticResource RowProgressStyle}">
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- 64px native cap maps to 32px: its dark HP channel starts at x≈50/2. -->
            <Setter Property="Margin" Value="25,0,25,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TargetUsesHeroFrame}" Value="True">
                    <Setter Property="Margin" Value="20,0,20,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TargetUsesLegendFrame}" Value="True">
                    <!-- Boss cap is 128px; its channel is only ~22px high in the source. -->
                    <Setter Property="Margin" Value="20,0,20,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailedTargetFillStyle" TargetType="ProgressBar" BasedOn="{StaticResource RowProgressStyle}">
            <Setter Property="Height" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="15,0,15,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TargetUsesHeroFrame}" Value="True">
                    <Setter Property="Margin" Value="12,0,12,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding TargetUsesLegendFrame}" Value="True">
                    <Setter Property="Margin" Value="12,0,12,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Two native-style phase ticks divide the boss health into thirds. -->
        <DrawingBrush x:Key="BossHpDivider" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF33291E" Geometry="M 4,0 L 8,4 4,8 0,4 Z M 4,16 L 8,20 4,24 0,20 Z" />
                    <GeometryDrawing Brush="#FFF0DBA5" Geometry="M 4,1 L 7,4 4,7 1,4 Z M 4,17 L 7,20 4,23 1,20 Z" />
                    <GeometryDrawing Geometry="M 4,6 L 4,18">
                        <GeometryDrawing.Pen><Pen Brush="#FF2A2119" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 4,6 L 4,18">
                        <GeometryDrawing.Pen><Pen Brush="#FFF4E2B8" Thickness="1" StartLineCap="Round" EndLineCap="Round" /></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="#FFD1D6D9" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>

        <Style x:Key="HeaderLogoButton" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="CompactHeaderIconButton" TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
            <Setter Property="Width" Value="36" />
        </Style>

        <Style x:Key="ModeIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFC0C5C7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="RootFrame" Margin="2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UsePartyRowStyle}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PartyPanelBackground}" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <!-- Полный режим -->
            <Grid x:Name="DetailedLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="27" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AdaptivePanelHeader}">
                    <Grid Margin="13,0,8,0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderLogoButton}" ToolTip="{services:LocalizedText Tools}" Click="OpenTools_Click">
                                <Control Width="28" Height="28" Template="{StaticResource MeterLogoTemplate}" IsHitTestVisible="False" />
                            </Button>
                            <TextBlock Margin="8,0,0,0" Text="{services:LocalizedText CombatAnalysis}" FontFamily="{StaticResource AionFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderIconButton}" ToolTip="{services:LocalizedText Settings}" Click="OpenTools_Click">
                                <Border Width="26" Height="26" Background="{StaticResource AionSettings}" />
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" ToolTip="{services:LocalizedText Opacity}" Click="CycleOpacityButton_Click">
                                <Border x:Name="OpacityIcon" Width="27" Height="27" Background="{StaticResource DmOpacity1}" />
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" ToolTip="{services:LocalizedText Compact}" Click="ToggleCompactButton_Click">
                                <Border Width="27" Height="27" Background="{StaticResource DmViewMin}" />
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" ToolTip="{services:LocalizedText MinimizeTray}" Click="MinimizeToTrayButton_Click">
                                <Grid Width="24" Height="24"><Border Height="2" Width="15" Background="#FFE8E3D6" VerticalAlignment="Bottom" Margin="0,0,0,4" /></Grid>
                            </Button>
                            <Button Style="{StaticResource HeaderIconButton}" ToolTip="{services:LocalizedText Close}" Click="CloseButton_Click">
                                <Border Width="24" Height="24" Background="{StaticResource AionClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="13,7,12,7" MinHeight="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="43" /><ColumnDefinition Width="43" /><ColumnDefinition Width="43" />
                        <ColumnDefinition Width="43" /><ColumnDefinition Width="43" /><ColumnDefinition Width="43" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ToggleParticipantsCommand}" ToolTip="{Binding ParticipantsModeTooltip}" IsEnabled="{Binding CanFilterParticipants}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPartyView}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="28" Height="28">
                            <Border Background="{StaticResource DmTarget}" Visibility="{Binding IsSelfView, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="{StaticResource DmAll}" Visibility="{Binding IsPartyView, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Margin="3,0,0,0" Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeTooltip}" IsEnabled="{Binding CanToggleBossFilter}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BossOnly}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="28" Height="28">
                            <Border Background="{StaticResource DmBossAuto}" Visibility="{Binding BossOnly, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="{StaticResource DmAll}" Visibility="{Binding BossOnly, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Margin="3,0,0,0" Command="{Binding ToggleDebuffsCommand}" ToolTip="{Binding DebuffToggleTooltip}" IsEnabled="{Binding IsDamageMode}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Setter Property="Opacity" Value="0.48" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTargetDebuffs}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Width="27" Height="27" Background="{StaticResource AionDebuffToggle}" />
                    </Button>
                    <Button Grid.Column="3" Margin="3,0,0,0" Command="{Binding TogglePvpCommand}" ToolTip="{Binding PvpModeTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPvpMode}" Value="True">
                                        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Control Width="30" Height="32" Template="{StaticResource CombatModeIconTemplate}" IsHitTestVisible="False" />
                    </Button>
                    <Button Grid.Column="4" Margin="3,0,0,0" Style="{StaticResource ModeIconButtonStyle}" ToolTip="{services:LocalizedText PartyCheck}" Click="OpenPartyCheck_Click">
                        <Border Width="27" Height="27" Background="{StaticResource AionPartyCheck}" />
                    </Button>
                    <Button Grid.Column="5" Margin="3,0,0,0" Style="{StaticResource ModeIconButtonStyle}" ToolTip="{services:LocalizedText ResetCombatTooltip}" Command="{Binding ResetCommand}">
                        <Border Width="27" Height="27" Background="{StaticResource AionRefresh}" />
                    </Button>
                    <Grid Grid.Column="6" Height="46" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="17" /><RowDefinition Height="19" /><RowDefinition Height="10" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding TargetName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFF2E7CB" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Grid x:Name="DetailedTargetHpAnchor" Grid.Row="1" Height="19" MaxWidth="570" HorizontalAlignment="Stretch">
                            <Grid Height="19">
                                <Grid Visibility="{Binding TargetUsesNormalFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /><ColumnDefinition Width="19" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="0,0,64,64" /></Image.Source></Image>
                                    <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="64,0,128,64" /></Image.Source></Image>
                                    <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="192,0,64,64" /></Image.Source></Image>
                                </Grid>
                                <Grid Visibility="{Binding TargetUsesEliteFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /><ColumnDefinition Width="19" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="0,0,64,64" /></Image.Source></Image>
                                    <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="64,0,128,64" /></Image.Source></Image>
                                    <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="192,0,64,64" /></Image.Source></Image>
                                </Grid>
                                <Grid Visibility="{Binding TargetUsesHeroFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /><ColumnDefinition Width="19" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="0,0,128,128" /></Image.Source></Image>
                                    <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="128,0,256,128" /></Image.Source></Image>
                                    <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="384,0,128,128" /></Image.Source></Image>
                                </Grid>
                                <Grid Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="19" /><ColumnDefinition Width="*" /><ColumnDefinition Width="19" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="0,24,128,88" /></Image.Source></Image>
                                    <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="128,24,256,88" /></Image.Source></Image>
                                    <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="384,24,128,88" /></Image.Source></Image>
                                </Grid>
                                <!-- The native boss bitmap contains a red strip at source y=83..87,
                                     below the HP channel. Cover only that strip, not its metal rims. -->
                                <Border Height="1.3" Margin="20,12.7,20,0" VerticalAlignment="Top"
                                        Background="#FF161718" IsHitTestVisible="False"
                                        Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}" />
                                <controls:SmoothProgressBar Minimum="0" Maximum="100" AnimatedValue="{Binding TargetHpPercent, Mode=OneWay}"
                                                            Foreground="{Binding TargetBarBrush}" Style="{StaticResource DetailedTargetFillStyle}" />
                                <Grid Height="15" Margin="19,0,19,0" VerticalAlignment="Center"
                                      Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="{StaticResource BossHpDivider}" />
                                    <Border Grid.Column="3" Background="{StaticResource BossHpDivider}" />
                                </Grid>
                                <TextBlock Text="{Binding TargetHpText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AionFont}" FontSize="8" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.95" /></TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Border Grid.Row="2" Height="10" MaxWidth="570" HorizontalAlignment="Center"
                                Background="{Binding EnrageBackground}"
                                Visibility="{Binding EnrageVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EnrageText}" Margin="4,0,4,0" FontSize="8" FontWeight="SemiBold"
                                       Foreground="{Binding EnrageForeground}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{StaticResource DarkStrip}" BorderBrush="#FF242B30" BorderThickness="0,1,0,1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,13,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SummaryLabel}" Text="{Binding SummaryDpsLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalDpsText}" FontFamily="{StaticResource AionFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Column="1" Margin="0,8" Background="#FF40494F" />
                        <Grid Grid.Column="2" Margin="13,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SummaryLabel}" Text="{Binding TotalAmountLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalDamageText}" FontFamily="{StaticResource AionFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="10,0,12,0"
                      Visibility="{Binding UsePartyRowStyle, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="74" /><ColumnDefinition Width="82" /><ColumnDefinition Width="92" /><ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnLabel}" Text="#" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnLabel}" Text="{Binding ParticipantsHeader}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnLabel}" Text="{Binding PerSecondColumnLabel}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="5" Style="{StaticResource ColumnLabel}" Text="{Binding AmountColumnLabel}" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="6" Style="{StaticResource ColumnLabel}" Text="{services:LocalizedText Share}" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="3" Margin="14,0"
                      Visibility="{Binding UsePartyRowStyle, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ParticipantsHeader}" Style="{StaticResource ColumnLabel}" />
                    <TextBlock Grid.Column="1" Text="{Binding PerSecondColumnLabel}" Margin="0,0,15,0"
                               Style="{StaticResource ColumnLabel}" />
                    <TextBlock Grid.Column="2" Text="{Binding AmountColumnLabel}"
                               Style="{StaticResource ColumnLabel}" />
                </Grid>

                <Grid Grid.Row="4" Margin="9,0,9,0">
                        <ItemsControl ItemsSource="{Binding Players}"
                                      Visibility="{Binding UsePartyRowStyle, Converter={StaticResource InverseBoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:SmoothStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="48" Margin="0,0,0,3" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="PlayerRow_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F01A232C" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SoftLine}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <controls:SmoothProgressBar Minimum="0" Maximum="100" AnimatedValue="{Binding BarPercent}" Foreground="{Binding AccentBrush}" Opacity="0.33" Style="{StaticResource RowProgressStyle}" />
                                            <Grid Margin="0,3"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding IsLocalPlayer, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="4*" />
                                                </Grid.ColumnDefinitions>
                                                <Control Grid.Column="0" Template="{StaticResource LocalPlayerSparklesTemplate}" />
                                            </Grid>
                                            <Border Width="3" Background="{Binding AccentBrush}" HorizontalAlignment="Left" />
                                            <Border Width="3" Background="#FFE2D8FF" HorizontalAlignment="Left" Visibility="{Binding IsLocalPlayer, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid Margin="5,0,7,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="74" /><ColumnDefinition Width="82" /><ColumnDefinition Width="92" /><ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFB4BCC1" />
                                                <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center">
                                                    <Ellipse Width="28" Height="28" Fill="{StaticResource ClassIconBackdrop}" />
                                                    <Image Source="{Binding IconPath}" Width="25" Height="25" Stretch="Uniform"
                                                           Style="{StaticResource PartyClassIconStyle}" />
                                                </Grid>
                                                <StackPanel Grid.Column="2" Margin="7,0" VerticalAlignment="Center">
                                                    <Grid Height="18" ToolTip="{Binding Nickname}">
                                                        <controls:MarqueeTextBlock Text="{Binding Nickname}" FontSize="13" FontWeight="Bold">
                                                            <controls:MarqueeTextBlock.Style>
                                                                <Style TargetType="{x:Type controls:MarqueeTextBlock}"
                                                                       BasedOn="{StaticResource {x:Type controls:MarqueeTextBlock}}">
                                                                    <Setter Property="Foreground" Value="#FFF4F2ED" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                                            <Setter Property="Foreground" Value="#FFF4F0FF" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:MarqueeTextBlock.Style>
                                                        </controls:MarqueeTextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ClassName}" Margin="0,1,0,0" FontSize="9" FontWeight="SemiBold" Foreground="#FFB6BDC1" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowMitigation, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{services:LocalizedText MitigationHint}">
                                                    <Border Width="15" Height="15" Margin="0,0,3,0" Background="{StaticResource AionMitigationShield}" />
                                                    <TextBlock Text="{Binding MitigationText}"
                                                               FontFamily="{StaticResource AionBodyFont}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#FF91C9F4"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Grid.Column="5" Text="{Binding DamageText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Grid.Column="6" Text="{Binding ShareText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Players}"
                                  Visibility="{Binding UsePartyRowStyle, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:SmoothStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:PartyDamageRow Height="48" Margin="0,0,0,3" Cursor="Hand"
                                                         MouseLeftButtonDown="PlayerRow_MouseLeftButtonDown" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding HasPlayers, Converter={StaticResource InverseBoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{services:LocalizedText NoCombatData}" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#FF9AA2A7" />
                        <TextBlock Text="{services:LocalizedText NoCombatHint}" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="#FF717B81" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="5" BorderBrush="{StaticResource SoftLine}" BorderThickness="0,1,0,0">
                    <Grid Margin="6,4,8,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Margin="0,0,7,0" Padding="9,0" Background="#4A10161B" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="2">
                            <TextBlock Text="{Binding EventScheduleStatus}" FontSize="10" Foreground="#FFB8C0C4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" Command="{Binding TogglePauseCommand}">
                            <TextBlock Text="{Binding PauseText}" FontSize="9" FontWeight="Bold" Foreground="#FFCDD3D6" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Компактный режим с отображением всей группы -->
            <Grid x:Name="CompactLayout" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" /><RowDefinition Height="44" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource AdaptivePanelHeader}">
                    <Grid Margin="13,0,7,0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderLogoButton}" ToolTip="{services:LocalizedText Tools}" Click="OpenTools_Click">
                                <Control Width="30" Height="30" Template="{StaticResource MeterLogoTemplate}" IsHitTestVisible="False" />
                            </Button>
                            <TextBlock Margin="6,0,0,0" Text="{services:LocalizedText CombatAnalysis}" FontFamily="{StaticResource AionFont}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CompactHeaderIconButton}" ToolTip="{services:LocalizedText Settings}" Click="OpenTools_Click">
                                <Border Width="26" Height="26" Background="{StaticResource AionSettings}" />
                            </Button>
                            <Button Style="{StaticResource CompactHeaderIconButton}" ToolTip="{services:LocalizedText Opacity}" Click="CycleOpacityButton_Click">
                                <Border x:Name="CompactOpacityIcon" Width="27" Height="27" Background="{StaticResource DmOpacity1}" />
                            </Button>
                            <Button Style="{StaticResource CompactHeaderIconButton}" ToolTip="{services:LocalizedText Expand}" Click="ToggleCompactButton_Click">
                                <Border Width="27" Height="27" Background="{StaticResource DmViewMax}" />
                            </Button>
                            <Button Style="{StaticResource CompactHeaderIconButton}" ToolTip="{services:LocalizedText MinimizeTray}" Click="MinimizeToTrayButton_Click">
                                <Grid Width="24" Height="24"><Border Height="2" Width="15" Background="#FFE8E3D6" VerticalAlignment="Bottom" Margin="0,0,0,4" /></Grid>
                            </Button>
                            <Button Style="{StaticResource CompactHeaderIconButton}" ToolTip="{services:LocalizedText Close}" Click="CloseButton_Click">
                                <Border Width="24" Height="24" Background="{StaticResource AionClose}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="13,4,12,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Command="{Binding ToggleParticipantsCommand}" ToolTip="{Binding ParticipantsModeTooltip}" IsEnabled="{Binding CanFilterParticipants}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPartyView}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="28" Height="28">
                            <Border Background="{StaticResource DmTarget}" Visibility="{Binding IsSelfView, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="{StaticResource DmAll}" Visibility="{Binding IsPartyView, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Margin="2,0,0,0" Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeTooltip}" IsEnabled="{Binding CanToggleBossFilter}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BossOnly}" Value="True">
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="28" Height="28">
                            <Border Background="{StaticResource DmBossAuto}" Visibility="{Binding BossOnly, Converter={StaticResource BoolToVisibility}}" />
                            <Border Background="{StaticResource DmAll}" Visibility="{Binding BossOnly, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="3" Margin="2,0,0,0" Command="{Binding ToggleDebuffsCommand}" ToolTip="{Binding DebuffToggleTooltip}" IsEnabled="{Binding IsDamageMode}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Setter Property="Opacity" Value="0.48" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTargetDebuffs}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Border Width="27" Height="27" Background="{StaticResource AionDebuffToggle}" />
                    </Button>
                    <Button Grid.Column="4" Margin="2,0,0,0" Command="{Binding TogglePvpCommand}" ToolTip="{Binding PvpModeTooltip}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModeIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPvpMode}" Value="True">
                                        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFFFC95C" BlurRadius="10" ShadowDepth="0" Opacity="0.95" /></Setter.Value></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Control Width="30" Height="32" Template="{StaticResource CombatModeIconTemplate}" IsHitTestVisible="False" />
                    </Button>
                    <Button Grid.Column="5" Margin="2,0,0,0" Style="{StaticResource ModeIconButtonStyle}" ToolTip="{services:LocalizedText PartyCheck}" Click="OpenPartyCheck_Click">
                        <Border Width="27" Height="27" Background="{StaticResource AionPartyCheck}" />
                    </Button>
                    <Button Grid.Column="6" Margin="2,0,0,0" Style="{StaticResource ModeIconButtonStyle}" ToolTip="{services:LocalizedText ResetCombatTooltip}" Command="{Binding ResetCommand}">
                        <Border Width="27" Height="27" Background="{StaticResource AionRefresh}" />
                    </Button>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{StaticResource SoftLine}" BorderThickness="0,1,0,1">
                    <Grid Margin="7,4,7,5">
                        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="35" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <!-- Таймер боя остаётся в данных и копируемой сводке, но не занимает место в оверлее. -->
                        <Grid>
                            <Border x:Name="CompactTargetMarquee" ClipToBounds="True" SizeChanged="CompactTargetMarquee_SizeChanged" ToolTip="{Binding TargetName}">
                                <Grid>
                                    <TextBlock x:Name="CompactTargetNameText"
                                               Text="{Binding TargetName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               FontFamily="{StaticResource AionFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#FFF2E7CB"
                                               TextWrapping="NoWrap">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="CompactTargetNameTranslate" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Рамка режется на три части: декоративные края не деформируются. -->
                        <Grid x:Name="CompactTargetHpAnchor" Grid.Row="1" Height="32" MaxWidth="570" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="{services:LocalizedText TargetHealth}">
                            <Grid Visibility="{Binding TargetUsesNormalFrame, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="0,0,64,64" /></Image.Source></Image>
                                <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="64,0,128,64" /></Image.Source></Image>
                                <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource TargetHpFrameBitmap}" SourceRect="192,0,64,64" /></Image.Source></Image>
                            </Grid>
                            <Grid Visibility="{Binding TargetUsesEliteFrame, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="0,0,64,64" /></Image.Source></Image>
                                <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="64,0,128,64" /></Image.Source></Image>
                                <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource EliteHpFrameBitmap}" SourceRect="192,0,64,64" /></Image.Source></Image>
                            </Grid>
                            <Grid Visibility="{Binding TargetUsesHeroFrame, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="0,0,128,128" /></Image.Source></Image>
                                <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="128,0,256,128" /></Image.Source></Image>
                                <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource HeroHpFrameBitmap}" SourceRect="384,0,128,128" /></Image.Source></Image>
                            </Grid>
                            <Grid Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="0,24,128,88" /></Image.Source></Image>
                                    <Image Grid.Column="1" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="128,24,256,88" /></Image.Source></Image>
                                    <Image Grid.Column="2" Stretch="Fill"><Image.Source><CroppedBitmap Source="{StaticResource BossHpFrameBitmap}" SourceRect="384,24,128,88" /></Image.Source></Image>
                            </Grid>
                            <Border Height="2.5" Margin="34,21,34,0" VerticalAlignment="Top"
                                    Background="#FF161718" IsHitTestVisible="False"
                                    Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}" />
                            <controls:SmoothProgressBar Minimum="0" Maximum="100" AnimatedValue="{Binding TargetHpPercent, Mode=OneWay}"
                                                        Foreground="{Binding TargetBarBrush}" Style="{StaticResource CompactTargetFillStyle}" />
                                <Grid Height="24" Margin="32,0,32,0" VerticalAlignment="Center"
                                      Visibility="{Binding TargetUsesLegendFrame, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="{StaticResource BossHpDivider}" />
                                    <Border Grid.Column="3" Background="{StaticResource BossHpDivider}" />
                                </Grid>
                            <TextBlock Text="{Binding TargetHpText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource AionFont}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFFFF">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF000000" BlurRadius="2" ShadowDepth="1" Opacity="0.95" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>

                        <Border Grid.Row="1" Height="11" MaxWidth="570" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Background="{Binding EnrageBackground}"
                                Visibility="{Binding EnrageVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding EnrageText}" Margin="5,0,5,0" FontFamily="{StaticResource AionBodyFont}"
                                       FontSize="9" FontWeight="SemiBold" Foreground="{Binding EnrageForeground}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Border>

                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="6,0,6,0">
                        <ItemsControl ItemsSource="{Binding Players}"
                                      Visibility="{Binding UsePartyRowStyle, Converter={StaticResource InverseBoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><controls:SmoothStackPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="38" Margin="0,0,0,2" ClipToBounds="True" Cursor="Hand" MouseLeftButtonDown="PlayerRow_MouseLeftButtonDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F01A232C" />
                                                <Setter Property="BorderBrush" Value="{StaticResource SoftLine}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <controls:SmoothProgressBar Minimum="0" Maximum="100" AnimatedValue="{Binding BarPercent}" Foreground="{Binding AccentBrush}" Opacity="0.33" Style="{StaticResource RowProgressStyle}" />
                                            <Grid Margin="0,3"
                                                  IsHitTestVisible="False"
                                                  Visibility="{Binding IsLocalPlayer, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="4*" />
                                                </Grid.ColumnDefinitions>
                                                <Control Grid.Column="0" Template="{StaticResource LocalPlayerSparklesTemplate}" />
                                            </Grid>
                                            <Border Width="3" Background="{Binding AccentBrush}" HorizontalAlignment="Left" />
                                            <Border Width="3" Background="#FFE2D8FF" HorizontalAlignment="Left" Visibility="{Binding IsLocalPlayer, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid Margin="4,0,5,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" /><ColumnDefinition Width="27" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="66" /><ColumnDefinition Width="58" /><ColumnDefinition Width="66" /><ColumnDefinition Width="46" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#FFBFC4C6" />
                                                <Grid Grid.Column="1" Width="27" Height="27" VerticalAlignment="Center">
                                                    <Ellipse Width="27" Height="27" Fill="{StaticResource ClassIconBackdrop}" />
                                                    <Image Source="{Binding IconPath}" Width="24" Height="24" Stretch="Uniform"
                                                           Style="{StaticResource PartyClassIconStyle}" />
                                                </Grid>
                                                <Grid Grid.Column="2" Margin="5,0" ToolTip="{Binding Nickname}">
                                                    <controls:MarqueeTextBlock Text="{Binding Nickname}" FontSize="12" FontWeight="Bold">
                                                        <controls:MarqueeTextBlock.Style>
                                                            <Style TargetType="{x:Type controls:MarqueeTextBlock}"
                                                                   BasedOn="{StaticResource {x:Type controls:MarqueeTextBlock}}">
                                                                <Setter Property="Foreground" Value="#FFF4F2ED" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLocalPlayer}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFF4F0FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:MarqueeTextBlock.Style>
                                                    </controls:MarqueeTextBlock>
                                                </Grid>
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowMitigation, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{services:LocalizedText MitigationHint}">
                                                    <Border Width="13" Height="13" Margin="0,0,2,0" Background="{StaticResource AionMitigationShield}" />
                                                    <TextBlock Text="{Binding MitigationText}"
                                                               FontFamily="{StaticResource AionBodyFont}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#FF91C9F4"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding DpsText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Grid.Column="5" Text="{Binding DamageText}" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Grid.Column="6" Text="{Binding ShareText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Players}"
                                  Visibility="{Binding UsePartyRowStyle, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><controls:SmoothStackPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:PartyDamageRow Height="38" Margin="0,0,0,2" Cursor="Hand"
                                                         MouseLeftButtonDown="PlayerRow_MouseLeftButtonDown" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Visibility="{Binding HasPlayers, Converter={StaticResource InverseBoolToVisibility}}" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="#FFB7A66F" />
                </Grid>

            </Grid>
        </Grid>
    </Border>

    <primitives:Popup x:Name="DebuffPopup"
                      PlacementTarget="{Binding ElementName=RootFrame}"
                      Placement="Right"
                      HorizontalOffset="6"
                      AllowsTransparency="True"
                      PopupAnimation="Fade"
                      StaysOpen="True"
                      Opened="DebuffPopup_Opened"
                      IsOpen="{Binding ShowDebuffIcons, Mode=OneWay}">
        <ItemsControl Width="80" ItemsSource="{Binding TargetDebuffs}" ItemTemplate="{StaticResource DebuffIconTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Width="80" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </primitives:Popup>

    <!-- Единая бегущая строка пристыкована к основному окну. -->
    <primitives:Popup x:Name="NotificationPopup"
                      PlacementTarget="{Binding ElementName=RootFrame}"
                      Placement="Bottom"
                      VerticalOffset="6"
                      AllowsTransparency="True"
                      StaysOpen="True"
                      IsHitTestVisible="False"
                      Opened="NotificationPopup_Opened"
                      Closed="NotificationPopup_Closed"
                      IsOpen="{Binding ShowNotificationPopup, Mode=OneWay}">
        <controls:NotificationTicker x:Name="AttachedNotificationTicker"
                                     Width="{Binding ActualWidth, ElementName=RootFrame}" />
    </primitives:Popup>
    </Grid>
</Window>
