<Window x:Class="Aion2Meter.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:services="clr-namespace:Aion2Meter.Services"
        Title="{services:LocalizedText ToolsTitle}"
        Width="720"
        Height="570"
        MinWidth="640"
        MinHeight="500"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ImageBrush x:Key="AionClose" ImageSource="/Aion2Meter;component/Assets/Textures/CommonAtlas.png" ViewboxUnits="Absolute" Viewbox="372,194,54,54" Stretch="Uniform" />

        <Style x:Key="ToolCard" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="204" />
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="0,0,9,9" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FF202A32" />
            <Setter Property="BorderBrush" Value="#2CFFFFFF" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFF1F2F2" />
        </Style>

        <Style x:Key="CardBody" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#FF9DA7AC" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DamageModeCard" TargetType="Button" BasedOn="{StaticResource ToolCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDamageMode}" Value="True">
                    <Setter Property="Background" Value="#FF294151" />
                    <Setter Property="BorderBrush" Value="#FF5C7B8E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HealingModeCard" TargetType="Button" BasedOn="{StaticResource ToolCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHealingMode}" Value="True">
                    <Setter Property="Background" Value="#FF28443C" />
                    <Setter Property="BorderBrush" Value="#FF5A907B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TakenModeCard" TargetType="Button" BasedOn="{StaticResource ToolCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDamageTakenMode}" Value="True">
                    <Setter Property="Background" Value="#FF49372E" />
                    <Setter Property="BorderBrush" Value="#FFA26F53" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,15,0,9" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CyanBrush}" />
        </Style>

        <Style x:Key="AuditRow" TargetType="Border">
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Background" Value="#7011171C" />
            <Setter Property="BorderBrush" Value="#1EFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Border Margin="2" Background="#F51A232C" BorderBrush="#FF62696D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="53" />
                <RowDefinition Height="*" />
                <RowDefinition Height="31" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0" Background="Transparent" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Aion II Meter" FontSize="16" FontWeight="Bold" />
                        <Border Margin="9,0,0,0" Padding="7,3" Background="#FF263C49" BorderBrush="#5535C1C0" BorderThickness="1">
                            <TextBlock Text="{services:LocalizedText ToolsHeading}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTip="{services:LocalizedText Close}" Click="CloseButton_Click">
                        <Border Width="31" Height="31" Background="{StaticResource AionClose}" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="17,4,8,20">
                    <TextBlock Text="{services:LocalizedText WorkingFeatures}" FontSize="18" FontWeight="Bold" />
                    <TextBlock Margin="0,4,0,0" Text="{services:LocalizedText WorkingFeaturesHint}" FontSize="10" Foreground="#FFA6AFB4" />

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText Language}" />
                    <WrapPanel>
                        <Button x:Name="EnglishButton" Style="{StaticResource ToolCard}" Click="English_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="English" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText LanguageHint}" /></StackPanel>
                        </Button>
                        <Button x:Name="RussianButton" Style="{StaticResource ToolCard}" Click="Russian_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="Русский" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText LanguageHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText Display}" />
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Command="{Binding ToggleModeCommand}" IsEnabled="{Binding IsDamageMode}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText BossAll}" /><TextBlock Style="{StaticResource CardBody}"><Run Text="{services:LocalizedText Now}" /><Run Text="{Binding ModeText, Mode=OneWay}" /></TextBlock></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Command="{Binding ShowSelfCommand}" IsEnabled="{Binding CanFilterParticipants}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText SelfOnly}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText SelfOnlyHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Command="{Binding ShowPartyCommand}" IsEnabled="{Binding CanFilterParticipants}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText WholeParty}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText WholePartyHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Click="ToggleLayout_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText WindowSize}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText WindowSizeHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Click="CycleOpacity_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText OpacityTitle}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText OpacityHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>
                    <Border Style="{StaticResource AuditRow}" Margin="0,5,9,5">
                        <StackPanel>
                            <CheckBox x:Name="PartyRowStyleCheckBox" IsChecked="{Binding UsePartyRowStyle, Mode=TwoWay}"
                                      Content="{services:LocalizedText PartyRowStyle}"
                                      FontSize="12" FontWeight="Bold" Foreground="#FFF1F2F2" />
                            <TextBlock Text="{services:LocalizedText PartyRowStyleHint}"
                                       Margin="23,5,0,0" FontSize="9" Foreground="#FF9DA7AC" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="0,0,9,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText WindowOpacity}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ElementName=WindowOpacitySlider, Path=Value, StringFormat={}{0:0}%}" Foreground="{StaticResource CyanBrush}" /></Grid>
                            <Slider x:Name="WindowOpacitySlider" Margin="0,8,0,0" Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText TextOpacity}" /><TextBlock HorizontalAlignment="Right" Text="{Binding ElementName=TextOpacitySlider, Path=Value, StringFormat={}{0:0}%}" Foreground="{StaticResource CyanBrush}" /></Grid>
                            <Slider x:Name="TextOpacitySlider" Margin="0,8,0,0" Minimum="25" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="OpacitySlider_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText StatisticsType}" />
                    <WrapPanel>
                        <Button Style="{StaticResource DamageModeCard}" Command="{Binding ShowDamageCommand}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText DamageDealt}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText DamageDealtHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource HealingModeCard}" Command="{Binding ShowHealingCommand}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText Healing}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText HealingHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TakenModeCard}" Command="{Binding ShowDamageTakenCommand}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText DamageTaken}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText DamageTakenHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText CharacterData}" />
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Click="OpenPets_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText Pets}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText PetsHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Click="OpenPartyCheck_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText PartyCheck}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText PartyCheckHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText Combat}" />
                    <Border Style="{StaticResource AuditRow}" Margin="0,0,9,5">
                        <StackPanel>
                            <CheckBox x:Name="OtherPlayersDebuffsCheckBox" IsChecked="{Binding ShowOtherPlayersDebuffs, Mode=TwoWay}"
                                      Content="{services:LocalizedText ShowOtherPlayersDebuffs}"
                                      FontSize="12" FontWeight="Bold" Foreground="#FFF1F2F2" />
                            <TextBlock Text="{services:LocalizedText ShowOtherPlayersDebuffsHint}"
                                       Margin="23,5,0,0" FontSize="9" Foreground="#FF9DA7AC" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolCard}" Click="OpenTimers_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText EventTimers}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText EventTimersHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Command="{Binding TogglePauseCommand}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{Binding PauseText}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText PauseHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Command="{Binding ResetCommand}">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText ResetCombat}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText ResetCombatHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Click="CopySummary_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText CopySummary}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText CopySummaryHint}" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolCard}" Click="CopyScreenshot_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText CopyScreenshot}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText CopyScreenshotHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText Notifications}" />
                    <Border Style="{StaticResource AuditRow}" Margin="0,0,9,2">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding KeepNotificationsWhenHidden, Mode=TwoWay}"
                                      Content="{services:LocalizedText KeepNotificationsWhenHidden}"
                                      FontSize="12" FontWeight="Bold" Foreground="#FFF1F2F2" />
                            <TextBlock Text="{services:LocalizedText KeepNotificationsWhenHiddenHint}"
                                       Margin="23,5,0,0" FontSize="9" Foreground="#FF9DA7AC" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UpdatesSection" Style="{StaticResource SectionTitle}" Text="{services:LocalizedText Updates}" />
                    <Border Style="{StaticResource AuditRow}" Margin="0,0,9,8">
                        <StackPanel>
                            <CheckBox x:Name="AutoCheckUpdatesCheckBox"
                                      Checked="AutoCheckUpdates_Changed" Unchecked="AutoCheckUpdates_Changed"
                                      Content="{services:LocalizedText AutoCheckUpdates}"
                                      FontSize="12" FontWeight="Bold" Foreground="#FFF1F2F2" />
                            <TextBlock Text="{services:LocalizedText AutoCheckUpdatesHint}"
                                       Margin="23,5,0,0" FontSize="9" Foreground="#FF9DA7AC" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolCard}" Click="CheckUpdates_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText CheckUpdates}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText CheckUpdatesHint}" /></StackPanel>
                        </Button>
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource ToolCard}"
                                Visibility="Collapsed" Click="InstallUpdate_Click">
                            <StackPanel><TextBlock Style="{StaticResource CardTitle}" Text="{services:LocalizedText InstallUpdate}" /><TextBlock Style="{StaticResource CardBody}" Text="{services:LocalizedText InstallUpdateHint}" /></StackPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{services:LocalizedText NextModules}" />
                    <Border Style="{StaticResource AuditRow}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{services:LocalizedText HistoryTraining}" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{services:LocalizedText HistoryTrainingHint}" Foreground="#FF9DA7AC" /></Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0">
                <Grid Margin="13,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="{Binding CaptureText}" VerticalAlignment="Center" FontSize="8" Foreground="#FF929CA1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="LIVE" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CyanBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
