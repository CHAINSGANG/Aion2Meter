<UserControl x:Class="Aion2Meter.Controls.NotificationTicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <ImageBrush x:Key="NativeClock"
                    ImageSource="/Aion2Meter;component/Assets/Textures/DamageMeterAtlas.png"
                    ViewboxUnits="Absolute"
                    Viewbox="164,60,54,54"
                    Stretch="Uniform" />
        <DataTemplate x:Key="TickerCycleTemplate">
            <ItemsControl ItemsSource="{Binding EventAlerts}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="26" Padding="8,0,6,0" Background="{Binding TickerBackground}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14" Background="{StaticResource NativeClock}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="5,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AionBodyFont}" FontSize="10" FontWeight="SemiBold" Foreground="#FFF8F6F0" />
                                <TextBlock Text="{Binding Countdown}" Width="56" Margin="6,0,0,0"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AionBodyFont}" FontSize="10" FontWeight="Bold"
                                           Foreground="#FFFFFFFF" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="Transparent">
        <Grid ClipToBounds="True">
            <Canvas x:Name="Viewport" ClipToBounds="True">
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.06" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.94" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
                <StackPanel x:Name="Track" Orientation="Horizontal" Canvas.Left="0" Canvas.Top="0">
                    <ContentPresenter x:Name="PrimaryCycle"
                                      Content="{Binding}"
                                      ContentTemplate="{StaticResource TickerCycleTemplate}" />
                </StackPanel>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
