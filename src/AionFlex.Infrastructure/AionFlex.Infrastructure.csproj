<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Aion2Meter.Infrastructure</AssemblyName>
    <RootNamespace>AionFlex.Infrastructure</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AionFlex\Infrastructure\PacketCapture\CaptureWatchdog.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketCapture\NpcapCaptureService.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketCapture\TcpPayloadSequencePolicy.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketParsing\GameStreamReassembler.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketParsing\Diagnostics\**\*.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketParsing\Dps\**\*.cs" />
    <Compile Include="AionFlex\Infrastructure\PacketParsing\Features\Pet\PetPacketParser.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aion2Meter.Smoke" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AionFlex.Core\AionFlex.Core.csproj" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="PacketDotNet" Version="1.4.7" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
  </ItemGroup>
</Project>
